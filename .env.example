# MyDrive Public / Non-Secret Build Configuration
# OAuth Client Secrets MUST remain strictly on the Node.js backend (backend/.env).
# Only public OAuth Client IDs, backend base URL, and GitHub release repository metadata are read here.
# Note: Keeping placeholders commented allows unrestricted APK sharing; configure secrets in backend/.env.

# MYDRIVE_BACKEND_URL=https://api.mydrive.example.com
# GITHUB_REPO_OWNER=your-github-username
# GITHUB_REPO_NAME=mydrive
# GOOGLE_OAUTH_CLIENT_ID=
# ONEDRIVE_OAUTH_CLIENT_ID=
# DROPBOX_OAUTH_CLIENT_ID=
# BOX_OAUTH_CLIENT_ID=
# PCLOUD_OAUTH_CLIENT_ID=
# KOOFR_OAUTH_CLIENT_ID=
