# MyDrive Node.js Backend Environment Variables
# All OAuth Client Secrets stay strictly here on the server — NEVER in the Android APK.

PORT=4000
DATABASE_URL=postgres://mydrive:CHANGE_ME@localhost:5432/mydrive
CORS_ORIGINS=https://mydrive.example.com

# 32-byte hex key (64 hex chars) for AES-256-GCM encryption of OAuth tokens in PostgreSQL
TOKEN_ENCRYPTION_KEY=

# JWT signing secret (min 32 random bytes)
JWT_SECRET=

# Official Cloud Provider OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=

KOOFR_CLIENT_ID=
KOOFR_CLIENT_SECRET=
